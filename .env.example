COMIC_APP_ROOT=/root/comic-inpaint
COMFY_ROOT=/root/ComfyUI
COMFY_URL=http://127.0.0.1:6006
COMFY_PYTHON=/root/comfy-qwen21-venv/bin/python
COMFY_LISTEN=0.0.0.0
APP_PYTHON=/root/miniconda3/bin/python
COMIC_DATA_ROOT=/root/autodl-tmp/comic-inpaint
COMIC_WEB_HOST=0.0.0.0
COMIC_WEB_PORT=6008
COMIC_MAX_UPLOAD_MB=2048
# Optional GPU detection; install isolated dependencies as documented before enabling.
# COMIC_DETECTION_PYTHON=/root/comic-inpaint/.venv-detection/bin/python
# COMIC_DETECTION_CONFIG=/root/comic-inpaint/config/detection-models.json
# Independent prelayout data and external CTD/OCR assets. See README before enabling inference.
# COMIC_PRELAYOUT_DATA_ROOT=/root/autodl-tmp/comic-inpaint/prelayout
# COMIC_PRELAYOUT_MODEL_ROOT=/root/models/comic-prelayout
# COMIC_PRELAYOUT_PYTHON=/root/comic-prelayout-venv/bin/python
# COMIC_PRELAYOUT_DEVICE=cuda
# For explicit local Apple Silicon testing only, set COMIC_PRELAYOUT_DEVICE=mps.
