# 複製到 var/local/start.env 後填入本機絕對路徑。var/ 不進 Git。
#   mkdir -p var/local
#   cp scripts/local.env.example var/local/start.env
# AutoDL 與正式鏡像不要使用這份設定。

COMIC_PRELAYOUT_DEVICE=mps

# 含 README「預排版模型與配套資產」五個檔名的來源工程根目錄。
# 該目錄下應能找到：
#   data/comictextdetector.pt
#   data/models/mit48pxctc_ocr.ckpt
#   data/alphabet-all-v5.txt
#   assets/fonts/NotoSansCJKjp-Medium.otf
#   assets/fonts/NotoSansCJKjp-Medium.ink-metrics.json
COMIC_PRELAYOUT_SOURCE=

# 預排版隔離 Python。留空則只做人工編輯。
# 若來源工程有 ctd_overlay_processor/.venv/bin/python，也可只填 SOURCE。
COMIC_PRELAYOUT_PYTHON=

# 可選：修圖 RF／MangaLens 的隔離 Python 與本機配置。
COMIC_DETECTION_PYTHON=
# COMIC_DETECTION_CONFIG=

# 可選覆蓋。未設時資料在倉庫 var/，模型連結在 var/local/prelayout-models。
# COMIC_WEB_PORT=6008
# COMIC_DATA_ROOT=
# COMIC_PRELAYOUT_MODEL_ROOT=
